---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero";
import FaqAccordion from "../components/faq/FaqAccordion";
import { faqs } from "../lib/faqs";
import { withBase, waLink } from "../lib/site";
import "../styles/home.css";

const allMonths = await getCollection("kalender-batch");
const today = new Date();
const currentKey = today.getFullYear() * 12 + today.getMonth();
const upcomingMonths = allMonths.map(entry => ({ id: entry.id, ...entry.data }))
  .sort((a, b) => a.id.localeCompare(b.id))
  .filter(month => { const [year, number] = month.id.split("-").map(Number); return year * 12 + number - 1 >= currentKey; }).slice(0, 3);
const order = { offline: 0, online: 1, rombongan: 2 };
const alumni = (await getCollection("alumni", entry => entry.data.featured))
  .map(entry => ({ ...entry.data, quote: (entry.body ?? "").trim() })).sort((a, b) => order[a.track] - order[b.track]);
const programs = [
  { title: "Hidup dalam bahasa Inggris.", label: "Offline / Bootcamp", image: "campus-discussion", alt: "Ilustrasi kelompok mahasiswa berdiskusi", body: "Tinggal di asrama, berlatih di English Area, dan bangun kebiasaan berbicara bersama teman belajar.", price: "Rp 1.800.000", duration: "2 minggu – 3 bulan", href: "/program/offline-bootcamp/", icon: "lucide:map-pin" },
  { title: "Ruang belajarmu, di mana saja.", label: "Kelas Online", image: "online-call", alt: "Ilustrasi sesi belajar melalui panggilan video", body: "Live class dengan interaksi langsung dan feedback tutor. Tetap belajar di tengah rutinitas kuliah atau kerja.", price: "Rp 650.000", duration: "2 minggu – 2 bulan", href: "/program/online/", icon: "lucide:monitor" },
];
const benefits = [
  { title: "Lebih banyak kesempatan bicara", text: "Kelas dengan maksimal 10 siswa memberi ruang untuk praktik dan feedback yang lebih personal." },
  { title: "Berlatih dengan native speaker", text: "Sesi bersama penutur asli tersedia pada paket tertentu. Pilih program sesuai kebutuhanmu." },
  { title: "Tujuan belajar yang terarah", text: "Dari confidence dan conversation hingga persiapan TOEFL atau IELTS, dengan evaluasi kemajuan." },
  { title: "Kenali lembaga sebelum mendaftar", text: "Pelajari profil perusahaan, tim pengajar, dan informasi program sebelum menentukan pilihan." },
];
const alumniPhotos = ["student-reading", "online-study", "team-workshop"];
---
<Layout title="Fantastico English Course — Bootcamp Offline & Kelas Online" description="Temukan jalur belajar bahasa Inggris yang cocok: bootcamp asrama atau live class online. Bandingkan program, biaya, dan jadwal intake Fantastico.">
  <Hero client:load />

  <div class="learning-band"><div class="section-shell learning-band-inner"><span><Icon name="lucide:messages-square" aria-hidden="true" /> Conversation & confidence</span><span><Icon name="lucide:graduation-cap" aria-hidden="true" /> TOEFL & IELTS preparation</span><span><Icon name="lucide:users" aria-hidden="true" /> Kelas kecil, latihan lebih personal</span></div></div>

  <section class="home-section section-shell" id="program">
    <div class="section-intro"><h2 class="section-heading">Dua cara belajar.<br />Satu langkah lebih maju.</h2><p class="section-lead">Pilih pengalaman yang sesuai dengan hidupmu. Belajar intensif bersama komunitas, atau tetap berkembang dari rumah.</p></div>
    <div class="path-grid">{programs.map(program => <article class="path-card">
      <a class="path-photo" href={withBase(program.href)} aria-label={`Lihat program ${program.label}`}><img src={withBase(`/images/pexels/${program.image}.webp`)} alt={program.alt} width="1000" height="750" loading="lazy" decoding="async" /><span><Icon name={program.icon} aria-hidden="true" />{program.label}</span></a>
      <div class="path-body"><h3>{program.title}</h3><p>{program.body}</p><div class="path-details"><span>Mulai <strong>{program.price}</strong></span><span>{program.duration}</span></div><a class="text-link" href={withBase(program.href)}>Jelajahi program <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a></div>
    </article>)}</div>
    <p class="media-note mt-4">Foto merupakan ilustrasi suasana belajar, bukan dokumentasi kelas Fantastico.</p>
  </section>

  <section class="why-section"><div class="section-shell why-grid">
    <div class="why-photos"><img class="why-large" src={withBase("/images/pexels/classroom-learning.webp")} alt="Ilustrasi kelas kolaboratif dengan pendampingan pengajar" width="1000" height="750" loading="lazy" /><img class="why-small" src={withBase("/images/pexels/library-study.webp")} alt="Ilustrasi latihan dan belajar di perpustakaan" width="1000" height="750" loading="lazy" /><div class="why-photo-caption">Percaya diri tumbuh<br />dari kebiasaan berlatih.<small>Foto ilustrasi · Pexels</small></div></div>
    <div class="why-copy"><h2 class="section-heading">Tempat untuk mencoba.<br />Ruang untuk berkembang.</h2><div class="benefit-list">{benefits.map(benefit => <div><h3>{benefit.title}</h3><p>{benefit.text}</p></div>)}</div><a class="text-link" href={withBase("/profile/perusahaan/")} >Kenali Fantastico lebih dekat <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a></div>
  </div></section>

  <section class="home-section section-shell">
    <div class="section-intro"><h2 class="section-heading">Mulai dari tujuanmu.</h2><a href={withBase("/biaya/")} class="text-link">Bandingkan semua paket <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a></div>
    <div class="goal-grid"><a href={withBase("/program/offline-bootcamp/")} ><Icon name="lucide:messages-square" aria-hidden="true" /><h3>Berani berbicara</h3><p>Bangun fondasi dan kelancaran lewat latihan conversation yang rutin.</p><span>Foundation & Active Speaker <Icon name="lucide:arrow-right" aria-hidden="true" /></span></a><a href={withBase("/program/online/")} ><Icon name="lucide:graduation-cap" aria-hidden="true" /><h3>Siap untuk tes bahasa</h3><p>Fokuskan belajarmu pada persiapan TOEFL atau IELTS sesuai paket.</p><span>Fluent & Test-Ready / Deep Progress <Icon name="lucide:arrow-right" aria-hidden="true" /></span></a><a href={withBase("/program/rombongan-instansi/")} ><Icon name="lucide:briefcase-business" aria-hidden="true" /><h3>Berkembang sebagai tim</h3><p>Kurikulum yang disesuaikan dengan kebutuhan sekolah atau perusahaan.</p><span>Rombongan & Instansi <Icon name="lucide:arrow-right" aria-hidden="true" /></span></a></div>
  </section>

  <section class="mentor-section section-shell"><div class="mentor-photo"><img src={withBase("/images/pexels/tutor-session.webp")} alt="Ilustrasi pengajar mendampingi sesi belajar" width="1000" height="750" loading="lazy" /><small>Foto ilustrasi · Pexels</small></div><div><h2 class="section-heading">Ada pendamping<br />di setiap proses.</h2><p class="section-lead">Latihan terasa lebih terarah saat ada seseorang yang mendengarkan, memberi feedback, dan membantu memahami langkah berikutnya.</p><div class="mentor-links"><a class="button-primary" href={withBase("/profile/guru-tutor/")} >Kenali tim pengajar <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a><a class="text-link" href={withBase("/fasilitas/")} >Jelajahi fasilitas <Icon name="lucide:arrow-right" aria-hidden="true" /></a></div></div></section>

  <section class="intake-section"><div class="section-shell intake-grid"><div><h2 class="section-heading">Kapan kamu<br />ingin mulai?</h2><p class="section-lead">Atur waktu belajar dari sekarang. Lihat pilihan intake, lalu konsultasikan ketersediaan slot dengan admin.</p><a href={withBase("/kalender-akademik/")} class="text-link">Buka kalender akademik <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a><p class="media-note">Jadwal pratinjau bersumber dari data contoh kalender. Konfirmasi sebelum mendaftar.</p></div><div class="intake-list">{upcomingMonths.length ? upcomingMonths.map(month => <a href={withBase("/kalender-akademik/")} class="intake-row"><div><h3>{month.month} <span>{month.year}</span></h3><p>{month.intakeDates.join(" & ")}</p>{month.highlight && <small>{month.highlight}</small>}</div><Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>) : <div class="intake-empty"><h3>Jadwal intake sedang diperbarui.</h3><p>Hubungi admin untuk pilihan jadwal berikutnya.</p><a class="button-primary" href={waLink("Halo, saya ingin mengetahui jadwal intake terbaru.")} target="_blank" rel="noopener noreferrer">Tanya jadwal terbaru</a></div>}</div></div></section>

  <section class="home-section section-shell"><div class="section-intro"><h2 class="section-heading">Tujuan berbeda.<br />Semangat yang sama.</h2><a href={withBase("/alumni/")} class="text-link">Jelajahi kisah alumni <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a></div><p class="media-note alumni-disclosure">Contoh kisah dari PRD untuk pratinjau desain. Hasil dan identitas alumni belum diverifikasi.</p><div class="story-grid">{alumni.map((story, i) => <article class="story-card"><img src={withBase(`/images/pexels/${alumniPhotos[i % alumniPhotos.length]}.webp`)} alt="Ilustrasi perjalanan belajar, bukan foto alumni yang dikutip" width="1000" height="750" loading="lazy" /><div>{story.scoreAfter && <p class="story-result">{story.scoreType === "toefl" ? `TOEFL ${story.scoreBefore} → ${story.scoreAfter}` : `IELTS ${story.scoreAfter}`}<span>Contoh hasil di PRD</span></p>}<blockquote>{story.quote.replace(/^>\s*/gm, "")}</blockquote><p class="story-name">{story.name}</p><small>Foto ilustrasi · Pexels</small></div></article>)}</div></section>

  <section class="institution-section section-shell"><img src={withBase("/images/pexels/team-workshop.webp")} alt="Ilustrasi diskusi dan pelatihan tim profesional" width="1000" height="750" loading="lazy" /><div><h2 class="section-heading">Kemajuan yang<br />bisa diraih bersama.</h2><p class="section-lead">Program bahasa Inggris untuk sekolah, kampus, dan perusahaan. Kurikulum custom, laporan progress, serta pilihan onsite atau online untuk kelompok minimal 15 peserta.</p><a href={withBase("/program/rombongan-instansi/")} class="button-primary">Diskusikan kebutuhan tim <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a><small class="media-note">Foto ilustrasi pelatihan · Pexels</small></div></section>

  <section class="home-section section-shell faq-preview"><div><h2 class="section-heading">Masih ada<br />yang ingin ditanyakan?</h2><p class="section-lead">Kenali detail program agar kamu lebih yakin menentukan langkah.</p><a class="text-link" href={withBase("/faq/")} >Lihat semua pertanyaan <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a></div><FaqAccordion client:visible items={[faqs[0], faqs[2], faqs[6]]} /></section>

  <section class="closing-section"><div class="section-shell closing-grid"><div><h2>Langkah besar<br />dimulai dari<br /><span>percakapan kecil.</span></h2><p>Ceritakan tujuan belajarmu. Kami bantu memilih jalur dan paket yang sesuai.</p><a class="button-primary" href={waLink("Halo, saya ingin konsultasi program Fantastico English Course.")} target="_blank" rel="noopener noreferrer">Mulai konsultasi gratis <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a></div><figure><img src={withBase("/images/pexels/cafe-study.webp")} alt="Ilustrasi belajar dalam suasana santai" width="1000" height="750" loading="lazy" /><figcaption>Ruang baru untuk kebiasaan baru.<small>Foto ilustrasi · Pexels</small></figcaption></figure></div></section>
</Layout>
