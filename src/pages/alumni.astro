---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/shared/PageHeader.astro";
import { withBase } from "../lib/site";
import AlumniGrid from "../components/alumni/AlumniGrid";
const trackOrder = { offline: 0, online: 1, rombongan: 2 };
const allAlumni = await getCollection("alumni");
const testimonials = allAlumni.map((entry) => ({ ...entry.data, quote: (entry.body ?? "").trim() })).sort((a, b) => trackOrder[a.track] - trackOrder[b.track]);
---

<Layout title="Alumni & Hasil Belajar — Fantastico" description="Jelajahi format kisah dan hasil belajar berdasarkan jalur offline, online, serta instansi. Testimoni dan skor masih data contoh, bukan bukti terverifikasi.">
  <PageHeader title="Setiap target punya perjalanan belajarnya." subtitle="Persiapan studi, pekerjaan, atau kebutuhan tim: lihat bagaimana kisah belajar dapat diceritakan lewat pengalaman dan perkembangan kemampuan." />
  <section class="section-shell detail-section"><div class="grid gap-8 md:grid-cols-[1fr_1.1fr] md:items-center"><div><h2 class="section-heading">Cerita di balik<br />proses belajar.</h2><div class="mt-5 rounded-2xl bg-canvas-gold p-6 text-sm leading-relaxed text-navy"><p class="font-semibold">Seluruh kisah, nama, testimoni, dan skor di halaman ini adalah data contoh.</p><p class="mt-2">Belum merupakan hasil alumni Fantastico yang terverifikasi, bukan jaminan skor, beasiswa, atau hasil peserta lain. Foto Pexels hanya ilustrasi, bukan peserta asli.</p></div></div><div class="grid grid-cols-2 gap-3"><figure><img src={withBase("/images/pexels/student-reading.webp")} alt="Ilustrasi seseorang membaca untuk belajar" width="900" height="675" loading="lazy" class="aspect-[4/5] w-full rounded-2xl object-cover" /><figcaption class="media-note mt-2">Ilustrasi latihan mandiri.</figcaption></figure><figure class="mt-8"><img src={withBase("/images/pexels/graduation.webp")} alt="Ilustrasi suasana kelulusan akademik" width="900" height="675" loading="lazy" class="aspect-[4/5] w-full rounded-2xl object-cover" /><figcaption class="media-note mt-2">Ilustrasi pencapaian akademik. Bukan alumni Fantastico.</figcaption></figure></div></div></section>
  <section class="section-shell pb-20"><h2 class="section-heading mb-7">Jelajahi berdasarkan jalur.</h2><AlumniGrid client:load testimonials={testimonials} /></section>
  <section class="detail-section bg-canvas-soft"><div class="section-shell flex flex-col items-start justify-between gap-6 md:flex-row md:items-center"><div><h2 class="section-heading">Targetmu bisa berbeda.</h2><p class="section-lead mt-4">Mulai dari level awal dan kebutuhanmu, bukan dari janji hasil orang lain.</p></div><a href={withBase("/kontak/")} class="button-primary">Bahas target belajarmu</a></div></section>
</Layout>
