---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/shared/PageHeader.astro";
import FaqAccordion from "../components/faq/FaqAccordion";
import { faqs } from "../lib/faqs";
---

<Layout
  title="FAQ — Fantastico"
  description="Pertanyaan yang sering diajukan seputar program offline, online, dan rombongan Fantastico English Course."
>
  <PageHeader title="Pertanyaan yang Sering Diajukan." />

  <section class="mx-auto max-w-3xl px-6 py-16">
    <FaqAccordion client:visible items={faqs} />
  </section>
</Layout>
