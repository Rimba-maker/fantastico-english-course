---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/shared/PageHeader.astro";
import KalenderGrid from "../components/kalender/KalenderGrid";
import { withBase, waLink } from "../lib/site";
const allMonths = await getCollection("kalender-batch");
const months = allMonths.map((entry) => ({ id: entry.id, ...entry.data })).sort((a, b) => a.id.localeCompare(b.id));
---

<Layout title="Kalender Akademik & Jadwal Intake — Fantastico" description="Cek jadwal intake Januari hingga Desember. Buka detail bulan untuk melihat tanggal mulai dan menanyakan ketersediaan slot.">
  <PageHeader title="Sisihkan waktunya. Temukan bulan mulainya." subtitle="Jadwal intake dari Januari hingga Desember membantu kamu merencanakan waktu belajar di sela kuliah, pekerjaan, atau libur semester." />
  <section class="section-shell detail-section"><div class="mb-9 grid gap-7 md:grid-cols-[1.4fr_.6fr] md:items-center"><div><h2 class="section-heading">Kalender intake.</h2><p class="section-lead mt-4">Pilih bulan untuk melihat tanggal dan programnya. Ketersediaan dapat berubah; konfirmasikan slot dengan admin sebelum melakukan pembayaran.</p><div class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-sm text-ink-secondary" aria-label="Keterangan status"><span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-status-available" aria-hidden="true"></span>Tersedia</span><span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-status-almost-full" aria-hidden="true"></span>Hampir penuh</span><span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-status-full" aria-hidden="true"></span>Penuh</span></div></div><figure><img src={withBase("/images/pexels/planner.webp")} alt="Ilustrasi planner untuk mengatur waktu belajar" width="900" height="675" loading="lazy" class="aspect-[16/9] w-full rounded-2xl object-cover" /><figcaption class="media-note mt-2">Ilustrasi perencanaan waktu — foto Pexels.</figcaption></figure></div><KalenderGrid client:load months={months} /></section>
  <section class="detail-section bg-canvas-soft"><div class="section-shell flex flex-col items-start justify-between gap-6 md:flex-row md:items-center"><div><h2 class="section-heading">Punya waktu yang spesifik?</h2><p class="section-lead mt-4">Tanyakan intake terdekat dan pilihan paket yang sesuai.</p></div><div class="flex flex-wrap gap-4"><a href={withBase("/biaya/")} class="button-secondary">Bandingkan paket</a><a href={waLink("Halo, saya mau tanya slot intake terdekat.")} target="_blank" rel="noopener noreferrer" class="button-primary">Tanya slot terdekat</a></div></div></section>
</Layout>
