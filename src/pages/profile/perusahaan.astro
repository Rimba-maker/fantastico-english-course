---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/shared/PageHeader.astro";
import PhotoCard from "../../components/shared/PhotoCard.astro";
import StatsRow from "../../components/profile/StatsRow";
import { siteConfig } from "../../lib/site";

const misi = [
  'Menyediakan kurikulum terstruktur dengan hasil yang bisa diukur (skor TOEFL/IELTS, bukan sekadar "lancar")',
  "Membuka akses belajar fleksibel lewat jalur online untuk yang tidak bisa datang ke asrama",
  "Menjaga kualitas lewat kelas kecil dan akses native speaker",
  "Melayani kebutuhan institusi (sekolah/kampus/perusahaan) dengan program khusus",
];
---

<Layout
  title="Profil Perusahaan — Fantastico English Course"
  description="Lembaga bahasa Inggris terdaftar resmi dengan 3.000+ alumni."
>
  <PageHeader title="Tentang Fantastico English Course." />

  <section class="mx-auto max-w-3xl px-6 py-16 text-center">
    <PhotoCard
      src="/images/perusahaan-lobby.jpg"
      alt="Gedung dan lobi Fantastico English Course"
      aspect="aspect-[16/9]"
    />

    <p class="mt-10 text-body-lg text-ink">
      Fantastico English Course berdiri sejak {siteConfig.stats.foundedYear} sebagai evolusi dari model
      belajar immersive ala Kampung Inggris, dihadirkan dalam format yang lebih terstruktur — dengan
      jalur online dan offline, legalitas jelas, dan hasil yang bisa diukur secara konkret.
    </p>

    <div class="mt-12 rounded-lg bg-canvas p-8 text-left shadow-card">
      <h2 class="text-heading-lg text-navy">Visi</h2>
      <p class="mt-2 text-body-md text-ink-mute">
        Jadi lembaga bahasa Inggris paling dipercaya untuk hasil terukur, baik secara offline maupun
        online.
      </p>

      <h2 class="mt-8 text-heading-lg text-navy">Misi</h2>
      <ul class="mt-2 space-y-2">
        {
          misi.map((m) => (
            <li class="flex items-start gap-2 text-body-md text-ink-mute">
              <Icon name="lucide:check" class="mt-1 h-4 w-4 shrink-0 text-status-available" />
              {m}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12">
      <StatsRow client:visible />
    </div>

    <div class="mt-12 grid items-center gap-6 rounded-lg bg-canvas p-8 text-left shadow-card sm:grid-cols-2">
      <PhotoCard
        src="/images/perusahaan-legalitas.jpg"
        alt="Sertifikat dan dokumen legalitas resmi"
        aspect="aspect-[4/3]"
      />
      <div>
        <h2 class="text-heading-lg text-navy">Terdaftar Resmi.</h2>
        <p class="mt-2 text-body-md text-ink-mute">
          SK Diknas No. {siteConfig.legal.skDiknas} • NPSN {siteConfig.legal.npsn}
        </p>
        <p class="mt-1 text-body-md text-ink-mute">Badan Usaha: {siteConfig.legal.badanUsaha}</p>
      </div>
    </div>
  </section>
</Layout>
