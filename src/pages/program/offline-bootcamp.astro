---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/shared/PageHeader.astro";
import PhotoCard from "../../components/shared/PhotoCard.astro";
import ProgramTierCard from "../../components/program/ProgramTierCard";
import { offlineTiers as tiers } from "../../lib/programs";
import { waLink } from "../../lib/site";
---

<Layout
  title="Bootcamp Bahasa Inggris Asrama — Fantastico"
  description="Program bootcamp 1-3 bulan dengan asrama dan English Area 24 jam. Native speaker, persiapan TOEFL/IELTS."
>
  <PageHeader
    title="Bootcamp Asrama — Immersive Penuh, Hasil Maksimal."
    subtitle="Tinggal di asrama dengan English Area 24 jam, didampingi tutor yang tinggal bersama. Pilih durasi sesuai target dan waktu yang kamu punya."
  />

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2">
      <PhotoCard
        src="/images/offline-asrama.jpg"
        alt="Asrama siswa Fantastico English Course"
        caption="Asrama & English Area 24 jam"
      />
      <PhotoCard
        src="/images/offline-native-speaker.jpg"
        alt="Native speaker mengajar di kelas"
        caption="Sesi rutin dengan native speaker"
      />
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        tiers.map((tier, i) => (
          <ProgramTierCard
            client:visible
            index={i}
            icon={tier.icon}
            title={tier.title}
            price={tier.price}
            suitableFor={tier.suitableFor}
            features={tier.features}
            featured={tier.featured}
            ctaHref={waLink(`Halo, saya mau konsultasi program ${tier.title}.`)}
            ctaLabel="Konsultasi via WhatsApp"
          />
        ))
      }
    </div>

    <p class="mt-8 text-center text-caption text-ink-mute">
      Semua bootcamp termasuk asrama. Biaya kos (jika pilih di luar asrama resmi) dihitung terpisah —
      lihat halaman <a href="/fasilitas/" class="text-navy underline-offset-4 hover:underline">Fasilitas</a>.
    </p>

    <div class="mt-10 text-center">
      <a
        href={waLink("Halo, saya mau konsultasi Program Offline / Bootcamp.")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full bg-navy px-6 py-3 text-button-md text-white"
      >
        Konsultasi Program Offline via WhatsApp
      </a>
    </div>
  </section>
</Layout>
