---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/shared/PageHeader.astro";
import PhotoCard from "../../components/shared/PhotoCard.astro";
import ProgramTierCard from "../../components/program/ProgramTierCard";
import { waLink } from "../../lib/site";

const tiers = [
  {
    emoji: "⚡",
    title: "Online 2 Minggu — Trial Sprint",
    price: "Rp 650.000",
    suitableFor: "Cocok untuk: coba dulu sebelum commit, atau butuh polish cepat sebelum interview/acara tertentu",
    features: ["Live class via Zoom, 5x/minggu", "Modul digital + grup diskusi WhatsApp", "Sertifikat kelulusan"],
  },
  {
    emoji: "📈",
    title: "Online 1 Bulan — Regular Progress",
    price: "Rp 1.200.000",
    suitableFor: "Cocok untuk: yang mau belajar rutin tapi tetap fleksibel dari rumah/kantor",
    features: [
      "Semua di Trial Sprint",
      "1x sesi private feedback dengan tutor",
      "Akses rekaman kelas (untuk yang ketinggalan sesi)",
    ],
  },
  {
    emoji: "🎯",
    title: "Online 2 Bulan — Deep Progress",
    price: "Rp 2.200.000",
    suitableFor: "Cocok untuk: yang serius mau level up signifikan tanpa harus pindah ke asrama",
    features: [
      "Live class rutin + modul TOEFL/IELTS prep",
      "1x sesi native speaker online/minggu",
      "2x sesi private feedback dengan tutor",
      "Sertifikat kelulusan",
    ],
    featured: true,
  },
];
---

<Layout
  title="Kelas Online Bahasa Inggris — Fantastico"
  description="Live class rutin, fleksibel dari rumah. Program 2 minggu hingga 2 bulan dengan sertifikat."
>
  <PageHeader
    title="Belajar Online, Standar Sama Seriusnya."
    subtitle="Live class rutin, bukan cuma video rekaman — kamu tetap dapat interaksi dan feedback langsung."
  />

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="mx-auto max-w-3xl">
      <PhotoCard
        src="/images/online-live-class.jpg"
        alt="Peserta mengikuti live class online"
        caption="Live class via Zoom — interaksi langsung, bukan rekaman"
        aspect="aspect-[16/9]"
      />
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        tiers.map((tier, i) => (
          <ProgramTierCard
            client:visible
            index={i}
            emoji={tier.emoji}
            title={tier.title}
            price={tier.price}
            suitableFor={tier.suitableFor}
            features={tier.features}
            featured={tier.featured}
            ctaHref={waLink(`Halo, saya mau konsultasi program ${tier.title}.`)}
            ctaLabel="Konsultasi via WhatsApp"
          />
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href={waLink("Halo, saya mau konsultasi Program Online.")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full bg-navy px-6 py-3 text-button-md text-white"
      >
        Konsultasi Program Online via WhatsApp
      </a>
    </div>
  </section>
</Layout>
