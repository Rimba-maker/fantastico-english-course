---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/shared/PageHeader.astro";
import ProgramTierCard from "../../components/program/ProgramTierCard";
import { onlineTiers as tiers } from "../../lib/programs";
import { withBase, waLink } from "../../lib/site";
---

<Layout title="Kelas Online Bahasa Inggris — Fantastico" description="Live class rutin dari rumah atau kantor. Bandingkan program 2 minggu hingga 2 bulan dengan feedback tutor dan sertifikat kelulusan.">
  <PageHeader title="Tetap dekat dengan target. Belajar dari mana saja." subtitle="Live class rutin, bukan cuma video rekaman — kamu tetap dapat interaksi dan feedback langsung. Belajar dari rumah atau kantor tanpa pindah kota." />
  <section class="section-shell detail-section">
    <div class="grid items-center gap-10 md:grid-cols-2"><figure><img src={withBase("/images/pexels/online-call.webp")} alt="Ilustrasi mengikuti panggilan video untuk belajar" width="1200" height="800" loading="lazy" class="aspect-[4/3] w-full rounded-2xl object-cover" /><figcaption class="media-note mt-3">Ilustrasi kelas jarak jauh. Foto Pexels, bukan dokumentasi kelas Fantastico.</figcaption></figure><div><h2 class="section-heading">Interaksi langsung.<br />Rutinitas yang fleksibel.</h2><p class="section-lead mt-5">Punya jadwal kuliah atau pekerjaan? Pilih durasi belajarnya, lalu konsultasikan jadwal live class yang cocok. Latihan, diskusi, dan feedback tetap jadi bagian dari perjalananmu.</p><div class="mt-6 flex flex-wrap gap-4"><a href="#paket" class="button-primary">Bandingkan paket online</a><a href={withBase("/faq/")} class="text-link">Pertanyaan tentang kelas</a></div></div></div>
  </section>
  <section id="paket" class="detail-section bg-canvas-soft"><div class="section-shell"><h2 class="section-heading">Mulai kecil. Lanjutkan lebih dalam.</h2><p class="section-lead mt-3 mb-8">Perhatikan durasi, akses rekaman, dan jumlah sesi feedback di setiap paket.</p><div class="grid gap-5 md:grid-cols-3">{tiers.map((tier, i) => <ProgramTierCard {...tier} index={i} ctaHref={waLink(`Halo, saya mau konsultasi program ${tier.title}.`)} ctaLabel="Konsultasi paket ini" />)}</div><p class="mt-7 max-w-3xl text-sm leading-relaxed text-ink-secondary">Sesi native speaker tersedia di Deep Progress. Akses rekaman tercantum di Regular Progress; konfirmasikan cakupan paket lain dengan admin. Sertifikat adalah kelulusan program, bukan skor TOEFL/IELTS resmi.</p></div></section>
  <section class="section-shell detail-section"><div class="grid items-center gap-8 md:grid-cols-[1.3fr_1fr]"><div><h2 class="section-heading">Belajar di sela hari,<br />bukan sendirian.</h2><p class="section-lead mt-4">Modul digital dan grup diskusi membantu menjaga latihan di luar sesi live. Bicarakan kebutuhanmu sebelum memilih paket.</p><a href={waLink("Halo, saya mau konsultasi Program Online.")} target="_blank" rel="noopener noreferrer" class="button-primary mt-6">Konsultasi program online</a></div><figure><img src={withBase("/images/pexels/online-study.webp")} alt="Ilustrasi belajar menggunakan laptop di rumah" width="900" height="675" loading="lazy" class="aspect-[4/3] w-full rounded-2xl object-cover" /><figcaption class="media-note mt-2">Ilustrasi belajar mandiri dengan laptop — foto Pexels.</figcaption></figure></div></section>
</Layout>
