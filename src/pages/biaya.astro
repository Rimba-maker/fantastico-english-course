---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/shared/PageHeader.astro";
import PriceTable from "../components/shared/PriceTable.astro";
import { waLink } from "../lib/site";

const offlineRows = [
  { paket: "Foundation Intensive", durasi: "1 Bulan", harga: "Rp 2.500.000" },
  { paket: "Active Speaker", durasi: "2 Bulan", harga: "Rp 4.500.000" },
  { paket: "Fluent & Test-Ready", durasi: "3 Bulan", harga: "Rp 6.500.000", featured: true },
  { paket: "Program Holiday", durasi: "2 Minggu", harga: "Rp 1.800.000" },
];

const onlineRows = [
  { paket: "Trial Sprint", durasi: "2 Minggu", harga: "Rp 650.000" },
  { paket: "Regular Progress", durasi: "1 Bulan", harga: "Rp 1.200.000" },
  { paket: "Deep Progress", durasi: "2 Bulan", harga: "Rp 2.200.000", featured: true },
];
---

<Layout
  title="Biaya & Paket — Fantastico"
  description="Ringkasan biaya program offline dan online Fantastico English Course, plus info metode pembayaran."
>
  <PageHeader
    title="Ringkasan Semua Biaya."
    subtitle="Detail lengkap tiap paket ada di halaman Program masing-masing — ini rangkuman cepat untuk perbandingan."
  />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="text-heading-lg text-navy">Offline / Bootcamp</h2>
    <div class="mt-4">
      <PriceTable rows={offlineRows} />
    </div>

    <h2 class="mt-12 text-heading-lg text-navy">Online</h2>
    <div class="mt-4">
      <PriceTable rows={onlineRows} />
    </div>

    <div class="mt-12 rounded-lg border border-hairline bg-canvas-soft p-6">
      <h2 class="text-heading-sm font-semibold text-navy">Rombongan & Instansi</h2>
      <p class="mt-2 text-body-md text-ink-mute">
        Custom quote (minimal 15 peserta) — konsultasi via <a
          href="/program/rombongan-instansi/"
          class="text-navy underline-offset-4 hover:underline"
        >WhatsApp</a>.
      </p>
    </div>

    <div class="mt-8">
      <h2 class="text-heading-sm font-semibold text-navy">Metode Pembayaran</h2>
      <p class="mt-2 text-body-md text-ink-mute">
        DP minimal 50%, pelunasan sebelum/saat program dimulai. Transfer bank atau QRIS.
      </p>
    </div>

    <div class="mt-10 text-center">
      <a
        href={waLink("Halo, saya mau konsultasi paket yang cocok buat saya.")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full bg-navy px-6 py-3 text-button-md text-white"
      >
        Konsultasi Paket yang Cocok via WhatsApp
      </a>
    </div>
  </section>
</Layout>
