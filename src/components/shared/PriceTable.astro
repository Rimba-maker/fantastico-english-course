---
interface Row {
  paket: string;
  durasi: string;
  harga: string;
  featured?: boolean;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border border-hairline">
  <table class="w-full text-left">
    <thead class="bg-canvas-soft">
      <tr>
        <th class="px-4 py-3 text-caption font-semibold uppercase text-ink-mute">Paket</th>
        <th class="px-4 py-3 text-caption font-semibold uppercase text-ink-mute">Durasi</th>
        <th class="px-4 py-3 text-right text-caption font-semibold uppercase text-ink-mute">Harga</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr class={`border-t border-hairline ${r.featured ? "bg-canvas-gold" : ""}`}>
            <td class="px-4 py-3 text-body-md text-ink">
              {r.paket}
              {r.featured && <span class="ml-1 text-gold">⭐</span>}
            </td>
            <td class="px-4 py-3 text-body-md text-ink-mute">{r.durasi}</td>
            <td class="px-4 py-3 text-right text-body-tabular font-semibold text-gold">{r.harga}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
