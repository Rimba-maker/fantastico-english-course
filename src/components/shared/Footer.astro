---
import { Icon } from "astro-icon/components";
import { siteConfig, withBase } from "../../lib/site";
const groups = [
  { title: "Temukan programmu", links: [{label: "Offline / Bootcamp", href: "/program/offline-bootcamp/"}, {label: "Kelas Online", href: "/program/online/"}, {label: "Rombongan & Instansi", href: "/program/rombongan-instansi/"}, {label: "Biaya & Paket", href: "/biaya/"}] },
  { title: "Kenali Fantastico", links: [{label: "Profil Perusahaan", href: "/profile/perusahaan/"}, {label: "Guru & Tutor", href: "/profile/guru-tutor/"}, {label: "Fasilitas", href: "/fasilitas/"}, {label: "Alumni & Testimoni", href: "/alumni/"}] },
  { title: "Rencanakan belajarmu", links: [{label: "Kalender Akademik", href: "/kalender-akademik/"}, {label: "Pertanyaan Umum", href: "/faq/"}, {label: "Kontak & Pendaftaran", href: "/kontak/"}, {label: "Beranda", href: "/"}] },
];
---
<footer class="campus-footer bg-navy text-white">
  <div class="section-shell">
    <div class="footer-top">
      <div><a class="footer-brand" href={withBase("/")}>fantastico<span>.</span></a><p>{siteConfig.tagline}</p></div>
      <a class="footer-contact" href={withBase("/kontak/")}>Mari bicarakan tujuanmu <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>
    </div>
    <div class="footer-columns">
      {groups.map(group => <div><h2>{group.title}</h2><ul>{group.links.map(link => <li><a href={withBase(link.href)}>{link.label}</a></li>)}</ul></div>)}
      <div><h2>Tetap terhubung</h2><ul>{Object.entries(siteConfig.social).map(([name, href]) => <li><a href={href} target="_blank" rel="noopener noreferrer">{name.charAt(0).toUpperCase() + name.slice(1)} <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a></li>)}</ul><a class="email-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></div>
    </div>
    <div class="preview-note"><Icon name="lucide:info" aria-hidden="true" /><p>Pratinjau desain: foto Pexels adalah ilustrasi. Kontak, legalitas, profil tutor, dan testimoni contoh perlu diverifikasi dengan data asli sebelum situs dipublikasikan.</p></div>
    <div class="footer-bottom"><span>&copy; {new Date().getFullYear()} Fantastico English Course</span><span>Belajar hari ini. Buka peluang esok.</span></div>
  </div>
</footer>
<style>
  .campus-footer { padding-block: 60px 24px; }
  .footer-top { display: flex; justify-content: space-between; align-items: center; gap: 32px; padding-bottom: 48px; border-bottom: 1px solid rgb(255 255 255 / 18%); }
  .footer-brand { font: 700 52px/1 var(--font-display); letter-spacing: -.04em; }
  .footer-brand span { color: var(--color-gold); }
  .footer-top p { margin-top: 16px; font-size: 13px; color: #c8d7e2; }
  .footer-contact { display: inline-flex; align-items: center; gap: 18px; border-bottom: 1px solid rgb(255 255 255 / 50%); padding-block: 12px; font-size: 16px; }
  .footer-contact svg { width: 22px; height: 22px; }
  .footer-columns { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; padding-block: 42px; }
  .footer-columns h2 { font: 600 13px/1.5 var(--font-sans); letter-spacing: 0; margin-bottom: 18px; }
  ul { display: grid; gap: 12px; }
  li a, .email-link { font-size: 12px; color: #c8d7e2; }
  li a:hover, .email-link:hover { color: white; text-decoration: underline; }
  li a { display: inline-flex; align-items: center; gap: 8px; }
  li svg { width: 12px; height: 12px; }
  .email-link { display: inline-block; margin-top: 22px; }
  .preview-note { display: flex; gap: 10px; align-items: start; max-width: 850px; padding-bottom: 28px; color: #c8d7e2; font-size: 11px; line-height: 1.7; }
  .preview-note svg { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid rgb(255 255 255 / 18%); padding-top: 22px; color: #c8d7e2; font-size: 10px; }
  @media (max-width: 767px) { .campus-footer { padding-top: 44px; } .footer-top { flex-direction: column; align-items: start; gap: 24px; padding-bottom: 32px; } .footer-brand { font-size: 44px; } .footer-columns { grid-template-columns: repeat(2, 1fr); gap: 32px 20px; } .footer-bottom { flex-direction: column; gap: 8px; } }
</style>
