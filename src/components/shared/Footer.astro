---
import { siteConfig, footerLinks } from "../../lib/site";
---

<footer class="border-t border-hairline bg-canvas-soft">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-3">
    <div>
      <p class="text-heading-sm font-semibold text-navy">{siteConfig.name}</p>
      <p class="mt-2 text-body-md text-ink-mute">{siteConfig.tagline}</p>

      <div class="mt-6 flex gap-4 text-caption text-ink-mute">
        <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-navy">Instagram</a>
        <a href={siteConfig.social.tiktok} target="_blank" rel="noopener noreferrer" class="hover:text-navy">TikTok</a>
        <a href={siteConfig.social.youtube} target="_blank" rel="noopener noreferrer" class="hover:text-navy">YouTube</a>
        <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-navy">LinkedIn</a>
      </div>
    </div>

    <div>
      <p class="text-caption font-semibold uppercase tracking-wide text-ink-mute">Halaman</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-body-md text-ink">
        {footerLinks.map((link) => (
          <li><a href={link.href} class="hover:text-navy">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-caption font-semibold uppercase tracking-wide text-ink-mute">Kontak & Legalitas</p>
      <ul class="mt-3 space-y-2 text-body-md text-ink-mute">
        <li>{siteConfig.phone}</li>
        <li>{siteConfig.email}</li>
        <li>{siteConfig.address}</li>
        <li class="pt-2 text-caption">SK Diknas No. {siteConfig.legal.skDiknas}</li>
        <li class="text-caption">NPSN {siteConfig.legal.npsn}</li>
        <li class="text-caption">{siteConfig.legal.badanUsaha}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-hairline px-6 py-6 text-center text-caption text-ink-mute">
    &copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
  </div>
</footer>
