---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  aspect?: string;
}

const { src, alt, caption, aspect = "aspect-[4/3]" } = Astro.props;
---

<figure class="overflow-hidden rounded-lg shadow-card">
  <img src={src} alt={alt} class={`${aspect} w-full object-cover`} loading="lazy" />
  {caption && (
    <figcaption class="bg-canvas px-4 py-3 text-caption text-ink-mute">{caption}</figcaption>
  )}
</figure>
