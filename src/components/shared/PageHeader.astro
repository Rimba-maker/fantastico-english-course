---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-navy px-6 py-16 text-center text-white md:py-20">
  <h1 class="mx-auto max-w-3xl text-display-lg md:text-display-xl">{title}</h1>
  {subtitle && <p class="mx-auto mt-4 max-w-2xl text-body-lg text-navy-subtle">{subtitle}</p>}
</section>
