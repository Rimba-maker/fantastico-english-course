---
import { Icon } from "astro-icon/components";
interface Props { title: string; subtitle?: string; }
const { title, subtitle } = Astro.props;
const scenes: Record<string, { image: string; alt: string; caption: string }> = {
  "/program/offline-bootcamp/": { image: "campus-discussion", alt: "Ilustrasi mahasiswa berdiskusi bersama", caption: "Belajar bersama. Berlatih setiap hari." },
  "/program/online/": { image: "online-study", alt: "Ilustrasi belajar mandiri menggunakan laptop", caption: "Ruang belajarmu, di mana pun kamu berada." },
  "/program/rombongan-instansi/": { image: "team-workshop", alt: "Ilustrasi diskusi kelompok profesional", caption: "Satu tim. Kesempatan untuk tumbuh bersama." },
  "/profile/perusahaan/": { image: "campus-building", alt: "Ilustrasi lingkungan institusi pendidikan", caption: "Mengenal pendekatan belajar Fantastico." },
  "/profile/guru-tutor/": { image: "tutor-session", alt: "Ilustrasi pendampingan dalam sesi belajar", caption: "Di balik setiap progres, ada pendampingan." },
  "/fasilitas/": { image: "shared-space", alt: "Ilustrasi ruang bersama untuk belajar", caption: "Lingkungan yang mendukung kebiasaan belajar." },
  "/kalender-akademik/": { image: "planner", alt: "Ilustrasi perencanaan jadwal belajar", caption: "Rencanakan langkah berikutnya." },
  "/biaya/": { image: "study-notes", alt: "Ilustrasi catatan dan materi belajar", caption: "Pilih komitmen belajar yang tepat." },
  "/alumni/": { image: "graduation", alt: "Ilustrasi perayaan pencapaian pendidikan", caption: "Setiap tujuan punya perjalanan sendiri." },
  "/faq/": { image: "student-reading", alt: "Ilustrasi mahasiswa membaca materi belajar", caption: "Kenali program sebelum menentukan pilihan." },
  "/kontak/": { image: "online-call", alt: "Ilustrasi percakapan melalui panggilan video", caption: "Mulai dari sebuah percakapan." },
};
const scene = scenes[Astro.url.pathname] ?? scenes["/biaya/"];
---
<section class="page-opening section-shell">
  <a href="/" class="back-link"><Icon name="lucide:arrow-left" aria-hidden="true" /> Kembali ke beranda</a>
  <div class="opening-grid">
    <div class="opening-copy"><h1>{title}</h1>{subtitle && <p>{subtitle}</p>}</div>
    <figure><img src={`/images/pexels/${scene.image}.webp`} alt={scene.alt} width="1000" height="700" loading="eager" /><figcaption><span>{scene.caption}</span><small>Foto ilustrasi · Pexels</small></figcaption></figure>
  </div>
</section>
<style>
  .page-opening { padding-block: 32px 56px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--color-ink-mute); font-size: 12px; padding-block: 10px; }
  .back-link svg { width: 14px; height: 14px; }
  .back-link:hover { color: var(--color-navy); text-decoration: underline; }
  .opening-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; margin-top: 24px; }
  h1 { font-size: clamp(2.5rem, 4.1vw, 3.8rem); line-height: 1.08; letter-spacing: -.035em; }
  .opening-copy > p { color: var(--color-ink-mute); font-size: 16px; line-height: 1.8; margin-top: 24px; max-width: 60ch; }
  figure { overflow: hidden; border-radius: 16px; background: var(--color-canvas-soft); }
  img { display: block; width: 100%; height: 280px; object-fit: cover; }
  figcaption { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 20px; font-size: 12px; font-weight: 600; }
  figcaption small { font-size: 10px; white-space: nowrap; color: var(--color-ink-mute); font-weight: 400; }
  @media (max-width: 767px) { .page-opening { padding-block: 24px 40px; } .opening-grid { grid-template-columns: 1fr; gap: 28px; margin-top: 18px; } h1 { font-size: 38px; } img { height: 220px; } figcaption { padding: 12px 16px; } }
</style>
